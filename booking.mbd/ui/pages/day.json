{
  "type": "page",
  "metadata": {
    "title": "Today's slots"
  },
  "onInit": {
    "type": "tool",
    "tool": "book.state",
    "params": {}
  },
  "state": {
    "initial": {
      "rows": [],
      "takenCount": 0,
      "doubleCount": 0,
      "doubleNote": "",
      "bookingRule": "",
      "notice": ""
    }
  },
  "content": {
    "type": "container",
    "decoration": {
      "color": "{{theme.color.surfaceContainerHighest}}"
    },
    "child": {
      "type": "linear",
      "direction": "vertical",
      "children": [
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 20,
            "bottom": 16
          },
          "decoration": {
            "color": "{{theme.color.surface}}",
            "border": {
              "bottom": true,
              "color": "{{theme.color.outline}}",
              "width": 1
            }
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "CLINIC ROOM 2 · TODAY",
                    "style": {
                      "fontSize": 12,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 2.0
                    }
                  },
                  {
                    "type": "text",
                    "content": "Slots",
                    "style": {
                      "fontSize": 21,
                      "color": "{{theme.color.onSurface}}",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "gap": 4
              },
              {
                "type": "spacer"
              },
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "TAKEN",
                    "style": {
                      "fontSize": 11,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.6
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{takenCount}}",
                    "style": {
                      "fontSize": 26,
                      "color": "{{theme.color.onSurface}}",
                      "fontFamily": "JetBrainsMono"
                    }
                  }
                ],
                "gap": 4,
                "crossAxisAlignment": "end"
              }
            ]
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 10,
            "bottom": 4
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "button",
                "label": "Two ask at once · unsafe",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "book.stampede",
                  "params": {
                    "at": "10:30",
                    "first": "Smith",
                    "second": "Jones",
                    "mode": "unsafe"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "Two ask at once · safe",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "book.stampede",
                  "params": {
                    "at": "10:30",
                    "first": "Smith",
                    "second": "Jones",
                    "mode": "safe"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "Reset",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "book.reset",
                  "params": {}
                }
              }
            ]
          }
        },
        {
          "type": "expanded",
          "child": {
            "type": "container",
            "padding": {
              "left": 22,
              "right": 22,
              "top": 16,
              "bottom": 8
            },
            "child": {
              "type": "container",
              "padding": {
                "all": 18
              },
              "decoration": {
                "color": "{{theme.color.surface}}",
                "borderRadius": 14,
                "border": {
                  "color": "{{theme.color.outline}}",
                  "width": 1
                }
              },
              "child": {
                "type": "list",
                "items": "{{rows}}",
                "shrinkWrap": true,
                "itemSpacing": 10,
                "emptyMessage": "No slots on the book today",
                "itemTemplate": {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "container",
                      "width": 64,
                      "child": {
                        "type": "text",
                        "content": "{{item.at}}",
                        "textAlign": "start",
                        "style": {
                          "fontSize": 15,
                          "color": "{{theme.color.primary}}",
                          "textAlign": "start",
                          "fontFamily": "JetBrainsMono"
                        },
                        "maxLines": 1
                      },
                      "alignment": "centerStart"
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "expanded",
                      "child": {
                        "type": "container",
                        "padding": {
                          "left": 16
                        },
                        "child": {
                          "type": "text",
                          "content": "{{item.who}}",
                          "style": {
                            "fontSize": 16,
                            "color": "{{theme.color.onSurface}}"
                          }
                        }
                      }
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "container",
                      "width": 180,
                      "child": {
                        "type": "text",
                        "content": "{{item.confirmed}}",
                        "textAlign": "end",
                        "style": {
                          "fontSize": 13,
                          "color": "{{theme.color.warning}}",
                          "textAlign": "end",
                          "fontFamily": "JetBrainsMono"
                        },
                        "maxLines": 1
                      },
                      "alignment": "centerEnd"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 0,
            "bottom": 8
          },
          "child": {
            "type": "container",
            "padding": {
              "all": 18
            },
            "decoration": {
              "color": "{{theme.color.surface}}",
              "borderRadius": 14,
              "border": {
                "color": "{{theme.color.outline}}",
                "width": 1
              }
            },
            "child": {
              "type": "linear",
              "direction": "vertical",
              "children": [
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "TOLD YES TWICE",
                      "style": {
                        "fontSize": 11,
                        "color": "{{theme.color.onSurfaceVariant}}",
                        "letterSpacing": 1.6
                      }
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "text",
                      "content": "{{doubleCount}}",
                      "style": {
                        "fontSize": 18,
                        "color": "{{theme.color.warning}}",
                        "fontFamily": "JetBrainsMono"
                      }
                    }
                  ]
                },
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "{{doubleNote}}",
                      "style": {
                        "fontSize": 13,
                        "color": "{{theme.color.onSurfaceVariant}}"
                      }
                    }
                  ]
                }
              ],
              "gap": 8
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 4,
            "bottom": 18
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "content": "{{bookingRule}}",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.onSurfaceVariant}}"
                }
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "content": "{{notice}}",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.primary}}"
                }
              }
            ]
          }
        }
      ],
      "crossAxisAlignment": "stretch"
    }
  }
}
